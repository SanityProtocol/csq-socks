--- /dev/null
+++ b/rust-client/bind.rs
@@ -0,0 +1,41 @@
+//! csq-socks tun on Windows: `--bind-ip` binds every socket that has to leave by the physical network (VK, TURN,
+//! DNS, direct traffic) to that interface's IPv4 address. Under Windows' strong host model a socket bound to an
+//! address sends out the interface that owns it, past the tunnel's 0.0.0.0/1 + 128.0.0.0/1 routes. Unset, nothing
+//! changes.
+use std::net::{IpAddr, Ipv4Addr, SocketAddr};
+use std::sync::OnceLock;
+use tokio::net::{TcpSocket, TcpStream};
+
+static BIND_IP: OnceLock<Ipv4Addr> = OnceLock::new();
+
+pub fn set(ip: Ipv4Addr) {
+    let _ = BIND_IP.set(ip);
+}
+
+pub fn ip() -> Option<IpAddr> {
+    BIND_IP.get().map(|ip| IpAddr::V4(*ip))
+}
+
+/// The local address for a socket towards `peer`: the bound IPv4 for an IPv4 peer, otherwise any address.
+pub fn local_for(peer: &SocketAddr) -> SocketAddr {
+    match (peer, BIND_IP.get()) {
+        (SocketAddr::V4(_), Some(ip)) => SocketAddr::from((*ip, 0)),
+        (SocketAddr::V4(_), None) => SocketAddr::from(([0, 0, 0, 0], 0)),
+        (SocketAddr::V6(_), _) => SocketAddr::from(([0u16; 8], 0)),
+    }
+}
+
+pub fn local_v4() -> SocketAddr {
+    SocketAddr::from((BIND_IP.get().copied().unwrap_or(Ipv4Addr::UNSPECIFIED), 0))
+}
+
+pub async fn tcp_connect(server: SocketAddr) -> std::io::Result<TcpStream> {
+    match (server, BIND_IP.get()) {
+        (SocketAddr::V4(_), Some(ip)) => {
+            let socket = TcpSocket::new_v4()?;
+            socket.bind(SocketAddr::from((*ip, 0)))?;
+            socket.connect(server).await
+        }
+        _ => TcpStream::connect(server).await,
+    }
+}
